# Example release keystore configuration for Android
# Copy this file to `android/key.properties` and replace with your actual keystore values.
# NEVER commit `key.properties` or keystore files (.jks, .keystore) to git.

storePassword=your_store_password_here
keyPassword=your_key_password_here
keyAlias=your_key_alias_here
storeFile=/path/to/your/upload-keystore.jks
